# Identifiants de la base de test, chargés automatiquement par Laravel
# lorsque APP_ENV=testing (valeur fixée dans phpunit.xml).
#
#   cp .env.testing.example .env.testing
#
# Le fichier .env.testing réel n'est pas versionné : aucun identifiant,
# même de test, ne doit se trouver dans le dépôt.
DB_USERNAME=cesizen
DB_PASSWORD=change-me
