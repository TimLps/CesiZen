APP_NAME=CESIZen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cesizen
DB_USERNAME=cesizen
DB_PASSWORD=cesizen

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cesizen.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Laisser vide : l'authentification par session n'est pas activée, les clients
# s'authentifient par jeton Bearer. Un domaine déclaré ici obtiendrait la session.
SANCTUM_STATEFUL_DOMAINS=

L5_SWAGGER_GENERATE_ALWAYS=true
