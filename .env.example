# Variables consommées par docker compose (compose.yml et ses overrides).
# Copier en .env avant de lancer la stack :  cp .env.example .env
# Le fichier .env réel n'est jamais versionné.

# Clé de chiffrement Laravel. En générer une avec :
#   docker compose -f compose.yml -f compose.dev.yml run --rm app php artisan key:generate --show
APP_KEY=

# Base de données
DB_DATABASE=cesizen
DB_USERNAME=cesizen
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
